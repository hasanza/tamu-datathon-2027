flowchart LR
  Supplier -- SUPPLIES --> Part
  Shipment -- OF_PART --> Part
  Shipment -- TO_PLANT --> Plant
  Shipment -- FROM --> Supplier
  Model -- USES_PART --> Part
  Plant -- BUILDS_MODEL --> Model
