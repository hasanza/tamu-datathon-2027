  classDef cLot fill:#8b5cf6,stroke:#000,stroke-width:1px,color:#fff;
  class Lot cLot;
  classDef cProductionOrder fill:#ffffff,stroke:#000,stroke-width:1px,color:#000;
  class ProductionOrder cProductionOrder;
  classDef cCustomerOrder fill:#2fa66a,stroke:#000,stroke-width:1px,color:#fff;
  class CustomerOrder cCustomerOrder;
  classDef cDealer fill:#b30000,stroke:#000,stroke-width:1px,color:#fff;
  class Dealer cDealer;
  classDef cCustomer fill:#e6a100,stroke:#000,stroke-width:1px,color:#000;
  class Customer cCustomer;
  classDef cVehicle fill:#747474,stroke:#000,stroke-width:1px,color:#fff;
  class Vehicle cVehicle;
  classDef cDay fill:#4d6a8a,stroke:#000,stroke-width:1px,color:#fff;
