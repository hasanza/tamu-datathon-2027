  classDef cSupplier fill:#3b82f6,stroke:#000,stroke-width:1px,color:#fff;
  class Supplier cSupplier;
  classDef cPart fill:#8b5cf6,stroke:#000,stroke-width:1px,color:#fff;
  class Part cPart;
  classDef cModel fill:#c9cac8,stroke:#000,stroke-width:1px,color:#000;
  class Model cModel;
  classDef cShipment fill:#e6a100,stroke:#000,stroke-width:1px,color:#000;
