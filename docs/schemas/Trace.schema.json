        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "supplier_delay",
            "plant_outage",
            "quality_hold",
            "noise",
            "unconfirmed"
          ],
          "title": "Category",
