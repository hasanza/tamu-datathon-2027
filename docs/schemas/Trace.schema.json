{
  "$defs": {
    "Action": {
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "incident_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None for event-level actions such as escalate",
          "title": "Incident Id"
        },
        "agent": {
          "enum": [
            "coordinator",
            "supply_chain",
            "dealer_care",
            "quality",
            "supply_chain_planner",
            "dealer_network",
            "customer_care_quality"
          ],
          "title": "Agent",
          "type": "string"
        },
        "tool": {
          "enum": [
            "mes.get_schedule",
            "mes.reschedule",
            "mes.transfer",
            "dealer.notify",
            "dealer.stop_sale",
            "crm.loaner_availability",
            "crm.assign_loaner",
            "crm.notify_customer",
            "quality.hold_lot",
            "escalate"
          ],
          "title": "Tool",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "justification": {
          "description": "Which handbook rule and which affected record(s)",
          "title": "Justification",
          "type": "string"
        },
        "path_ids": {
          "description": "Graph node ids on the justifying path",
          "items": {
            "type": "string"
          },
          "title": "Path Ids",
          "type": "array"
        },
        "rehearsal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rehearsal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transport": {
          "anyOf": [
            {
              "enum": [
                "mcp/stdio",
                "twin",
                "in-process"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the call reached the enterprise (v0.2.0)",
          "title": "Transport"
        }
      },
      "required": [
        "seq",
        "agent",
        "tool",
        "args",
        "justification"
      ],
      "title": "Action",
      "type": "object"
    },
    "AgentRun": {
      "properties": {
        "agent": {
          "enum": [
            "coordinator",
            "supply_chain",
