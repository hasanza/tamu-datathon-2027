          "type": "array"
        },
        "ambiguities": {
          "items": {
            "$ref": "#/$defs/Ambiguity"
          },
          "title": "Ambiguities",
          "type": "array"
        },
        "reason": {
          "description": "One sentence: why this category / why actionable or not",
          "title": "Reason",
          "type": "string"
