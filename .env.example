# Copy to .env (never commit .env). Only CORE's machine needs real values.
LLM_PROVIDER=gemini            # gemini | anthropic (every call is live; no cache)
GEMINI_API_KEY=
GEMINI_MODEL=                  # leave empty to use the adapter default
ANTHROPIC_API_KEY=             # optional second backend (claude-haiku-5-5 / claude-sonnet-5-5)
ENTERPRISE_URL=http://127.0.0.1:8000
API_PORT=8001
